# Senora Environment Configuration Example
# Copy this file to .env and configure real secrets before running in production.
# NOTE: The server validates secrets on startup. Insecure defaults or placeholder
# strings will cause production startup to abort immediately.

# Domain name for Caddy auto-TLS (set to localhost for local testing)
DOMAIN=localhost

# PostgreSQL Credentials
POSTGRES_USER=senora
# Generate strong database password:
#   Bash: openssl rand -base64 32
#   PowerShell: -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 32 | ForEach-Object {[char]$_})
POSTGRES_PASSWORD=replace_with_a_secure_random_password_min_32_chars
POSTGRES_DB=senora_db

# Session Secret (cryptographic secret, minimum 32 characters / 256 bits of entropy)
# Generate session secret:
#   Bash: openssl rand -hex 32
#   PowerShell: -join ((65..90) + (97..122) + (48..57) | Get-Random -Count 64 | ForEach-Object {[char]$_})
SESSION_SECRET=replace_with_a_64_character_hex_or_base64_random_secret

# Server Environment (production / staging / development)
ENVIRONMENT=production

# Reverse Proxy Trust (set to true when behind Caddy or cloud load balancer)
TRUST_PROXY=true

# Trusted Proxy CIDRs/IPs (comma-separated list of explicit reverse proxy IPs/subnets)
# Default for Docker Compose bridge networks:
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12,10.0.0.0/8

# Allowed Origins (comma-separated exact origins for CORS and WebSocket validation, e.g. https://chat.example.com)
ALLOWED_ORIGINS=https://localhost
